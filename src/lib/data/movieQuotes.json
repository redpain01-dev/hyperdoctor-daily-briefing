[
  { "text": "희망은 좋은 것이죠. 어쩌면 가장 좋은 것일지도 몰라요.", "movie": "쇼생크 탈출", "year": 1994, "country": "해외 영화" },
  { "text": "현재를 즐겨라. 너희의 삶을 특별하게 만들어라.", "movie": "죽은 시인의 사회", "year": 1989, "country": "해외 영화" },
  { "text": "인생은 초콜릿 상자와 같단다. 무엇을 얻게 될지 아무도 모르지.", "movie": "포레스트 검프", "year": 1994, "country": "해외 영화" },
  { "text": "우리에게 주어진 시간으로 무엇을 할지 결정하는 것만이 우리의 몫이야.", "movie": "반지의 제왕: 반지 원정대", "year": 2001, "country": "해외 영화" },
  { "text": "이 세상에는 선한 것이 있고, 그것은 싸워 지킬 가치가 있어요.", "movie": "반지의 제왕: 두 개의 탑", "year": 2002, "country": "해외 영화" },
  { "text": "아주 작은 사람도 미래의 흐름을 바꿀 수 있어요.", "movie": "반지의 제왕: 반지 원정대", "year": 2001, "country": "해외 영화" },
  { "text": "사랑은 시간과 공간을 넘어 우리가 느낄 수 있는 단 하나의 것이야.", "movie": "인터스텔라", "year": 2014, "country": "해외 영화" },
  { "text": "넌 친절하고, 똑똑하고, 소중한 사람이야.", "movie": "헬프", "year": 2011, "country": "해외 영화" },
  { "text": "너의 순간을 붙잡아.", "movie": "코코", "year": 2017, "country": "해외 영화" },
  { "text": "우리가 친절하고 예의 바르면 세상은 달라질 거예요.", "movie": "패딩턴 2", "year": 2017, "country": "해외 영화" },
  { "text": "큰 힘에는 큰 책임이 따른다.", "movie": "스파이더맨", "year": 2002, "country": "해외 영화" },
  { "text": "얼마나 세게 때리느냐가 아니라, 맞고도 계속 나아갈 수 있느냐가 중요해.", "movie": "록키 발보아", "year": 2006, "country": "해외 영화" },
  { "text": "누구도 네가 할 수 없다고 말하게 두지 마. 나조차도.", "movie": "행복을 찾아서", "year": 2006, "country": "해외 영화" },
  { "text": "옳음과 친절함 중 하나를 선택해야 한다면 친절을 선택해.", "movie": "원더", "year": 2017, "country": "해외 영화" },
  { "text": "우리는 매일, 함께 시간을 여행하고 있어.", "movie": "어바웃 타임", "year": 2013, "country": "해외 영화" },
  { "text": "내 삶의 모든 순간을 살아볼 거야.", "movie": "소울", "year": 2020, "country": "해외 영화" },
  { "text": "다른 삶에서도 당신과 빨래하고 세금 내며 살고 싶었을 거야.", "movie": "에브리씽 에브리웨어 올 앳 원스", "year": 2022, "country": "해외 영화" },
  { "text": "무엇을 하게 되든, 그 일을 사랑해라.", "movie": "시네마 천국", "year": 1988, "country": "해외 영화" },
  { "text": "친구가 있는 사람은 실패한 인생이 아니야.", "movie": "멋진 인생", "year": 1946, "country": "해외 영화" },
  { "text": "집만 한 곳은 없어.", "movie": "오즈의 마법사", "year": 1939, "country": "해외 영화" },
  { "text": "이제 내가 해야 할 일을 알아. 계속 숨을 쉬는 거야.", "movie": "캐스트 어웨이", "year": 2000, "country": "해외 영화" },
  { "text": "계속 헤엄쳐.", "movie": "니모를 찾아서", "year": 2003, "country": "해외 영화" },
  { "text": "모험은 저 밖에 있어!", "movie": "업", "year": 2009, "country": "해외 영화" },
  { "text": "우리의 삶은 놓쳐버린 것까지 포함한 기회들로 정의돼.", "movie": "벤자민 버튼의 시간은 거꾸로 간다", "year": 2008, "country": "해외 영화" },
  { "text": "당신은 내가 더 나은 사람이 되고 싶게 해요.", "movie": "이보다 더 좋을 순 없다", "year": 1997, "country": "해외 영화" },
  { "text": "우리가 삶에서 한 일은 영원히 메아리친다.", "movie": "글래디에이터", "year": 2000, "country": "해외 영화" },
  { "text": "모든 사람은 죽지만, 모든 사람이 진정 살아가는 것은 아니다.", "movie": "브레이브하트", "year": 1995, "country": "해외 영화" },
  { "text": "아무도 기대하지 않은 사람이 아무도 상상하지 못한 일을 해내기도 해요.", "movie": "이미테이션 게임", "year": 2014, "country": "해외 영화" },
  { "text": "왜 넘어질까? 다시 일어서는 법을 배우기 위해서야.", "movie": "배트맨 비긴즈", "year": 2005, "country": "해외 영화" },
  { "text": "영웅은 누구나 될 수 있어.", "movie": "다크 나이트 라이즈", "year": 2012, "country": "해외 영화" },
  { "text": "모두가 위대한 예술가가 될 수는 없지만, 위대한 예술가는 어디서든 나올 수 있다.", "movie": "라따뚜이", "year": 2007, "country": "해외 영화" },
  { "text": "문제 하나를 풀고, 다음 문제를 풀다 보면 살아 돌아오게 돼.", "movie": "마션", "year": 2015, "country": "해외 영화" },
  { "text": "꿈꾸는 바보들을 위하여.", "movie": "라라랜드", "year": 2016, "country": "해외 영화" },
  { "text": "여정의 끝을 알면서도 나는 그 여정을 받아들여요.", "movie": "컨택트", "year": 2016, "country": "해외 영화" },
  { "text": "역경 속에서 피어난 꽃이 가장 귀하고 아름다운 법이야.", "movie": "뮬란", "year": 1998, "country": "해외 영화" },
  { "text": "어제는 역사고 내일은 수수께끼지만, 오늘은 선물이야.", "movie": "쿵푸팬더", "year": 2008, "country": "해외 영화" },
  { "text": "하거나, 하지 않거나. 해본다는 건 없어.", "movie": "스타워즈: 제국의 역습", "year": 1980, "country": "해외 영화" },
  { "text": "너는 네가 선택한 사람이야.", "movie": "아이언 자이언트", "year": 1999, "country": "해외 영화" },
  { "text": "어떤 사람을 위해서는 녹아도 괜찮아.", "movie": "겨울왕국", "year": 2013, "country": "해외 영화" },
  { "text": "과거는 아플 수 있어. 하지만 도망치거나, 거기서 배울 수 있지.", "movie": "라이온 킹", "year": 1994, "country": "해외 영화" },
  { "text": "난 뒤를 돌아보지 않아. 지금 이 순간에 집중할 수 없게 하거든.", "movie": "인크레더블", "year": 2004, "country": "해외 영화" },
  { "text": "한 걸음씩, 한 번씩, 한 라운드씩.", "movie": "크리드", "year": 2015, "country": "해외 영화" },
  { "text": "아름다운 마음을 발견하는 것은 훨씬 더 큰 선물이야.", "movie": "뷰티풀 마인드", "year": 2001, "country": "해외 영화" },
  { "text": "삶이 아무리 힘들어 보여도, 할 수 있고 이룰 수 있는 일은 늘 있어요.", "movie": "사랑에 대한 모든 것", "year": 2014, "country": "해외 영화" },
  { "text": "어떻게 사랑이 변하니?", "movie": "봄날은 간다", "year": 2001, "country": "한국 영화" },
  { "text": "나 다시 돌아갈래!", "movie": "박하사탕", "year": 1999, "country": "한국 영화" },
  { "text": "아들아, 너는 계획이 다 있구나.", "movie": "기생충", "year": 2019, "country": "한국 영화" },
  { "text": "신에게는 아직 열두 척의 배가 남아 있사옵니다.", "movie": "명량", "year": 2014, "country": "한국 영화" },
  { "text": "아버지, 내 약속 잘 지켰지예.", "movie": "국제시장", "year": 2014, "country": "한국 영화" },
  { "text": "대한민국 주권은 국민에게 있고, 모든 권력은 국민으로부터 나온다.", "movie": "변호인", "year": 2013, "country": "한국 영화" },
  { "text": "우산이 있는데 비를 맞는 사람이 어디 저 하나뿐인가요?", "movie": "클래식", "year": 2003, "country": "한국 영화" },
  { "text": "내 기억 속의 사진들처럼 사랑도 언젠가는 추억으로 그친다는 것을 알고 있었습니다.", "movie": "8월의 크리스마스", "year": 1998, "country": "한국 영화" },
  { "text": "아직 한 발 남았다.", "movie": "아저씨", "year": 2010, "country": "한국 영화" }
